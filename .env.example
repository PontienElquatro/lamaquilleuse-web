# ─── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ─── Database (Supabase) ────────────────────────────────────────────────
# Récupérer dans : Supabase → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── Supabase Storage ───────────────────────────────────────────────────
# Récupérer dans : Supabase → Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...          # anon/public key
SUPABASE_SERVICE_KEY=eyJ...       # service_role key (GARDER SECRET)
SUPABASE_BUCKET=lamaquilleuse

# ─── JWT ────────────────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHARS_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_CHARS_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAuth Google ───────────────────────────────────────────────────────
# Récupérer dans : console.cloud.google.com → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Mail SMTP ──────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx    # Gmail App Password
MAIL_FROM="LaMaquilleuse <noreply@lamaquilleuse.fr>"

# ─── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Rate Limiting ──────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
